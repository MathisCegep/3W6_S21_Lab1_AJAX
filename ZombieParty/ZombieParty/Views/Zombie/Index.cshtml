                function(data) {
                    //console.log(data);    // Validation
                    if (data) {
                        baliseA.removeClass("text-dark");
                        baliseA.addClass("text-primary");
                    } else {
                        baliseA.removeClass("text-primary");
                        baliseA.addClass("text-dark");
                    }
                });
        });
*/

        document.querySelectorAll(".detail-btn").forEach(function(element) { // element = balise
            element.addEventListener("click", function(event) {
                event.preventDefault();
                let idZombie = element.getAttribute("id")

                fetch("/Zombie/Details?id=" + idZombie)
                .then(function(answer){
                    return answer.text()
                })
                .then(function(html){
                        document.querySelector("#showmodal #content").innerHTML = html

                        // Permet d’afficher le modal (Utilisation de la méthode native de Bootstrap en JS)
                        let monModal = new bootstrap.Modal(document.getElementById('showmodal'))
                        monModal.show()
                })
            })
        })
            /*JQUARY
            $(".detail-btn").on("click", function() {
            let btn = $(this);
            let idZombie = btn.attr("id");
            $.get("/Zombie/Details", { "id" : idZombie }, // Construction de la requête get
               function (data) {
                 $("#showmodal #content").html(data); // Insère data dans le div avec l’id content
                 $("#showmodal").modal("show")        // Permet d’afficher le modal
                });
            });
*/
    </script>
}


<div class="container p-3">
    <div class="row pt-4">
        <div class="col-10">
            <h2 class="text-primary">@Locals["Title"]</h2>
        </div>
        <div class="col-2 text-right">
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus-square"></i>&nbsp;@Locals["New"]
            </a>
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <partial name="_ZombieCard" model="item"/>
        }
    </div>

    <div id="showmodal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document" style="background-color:white">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel">Zombie Details</h4>
            </div>
            <div class="container mt-3">
                <div id="content"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
