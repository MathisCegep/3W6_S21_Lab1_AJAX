@model IEnumerable<Zombie>

@section Scripts {
    <script>
        document.querySelectorAll(".favorite").forEach(function(element) { // element = baliseA
            element.addEventListener("click", function(){
                let idZombie = element.getAttribute("id")

                console.log(element)
                console.log(idZombie)

                fetch("/Zombie/Favorite", {
                    method: 'POST',
                    headers: {
                        // Dit à ASP.NET qu'on envoie des données de formulaire classiques
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body : "id=" + idZombie
                })
                .then(function(answer) {
                    return answer.json()
                   
                })
                .then(function(data){
                        console.log(data)
                    if (data){
                        element.classList.remove("text-dark")
                        element.classList.add("text-primary")
                    } else {
                            element.classList.remove("text-primary")
                            element.classList.add("text-dark")
                    }
                })


            })
        })

        /* JQUARY
        $(".favorite").on("click", function() {
            let baliseA = $(this);      // Allez chercher l'élément <a> qui a été cliqué.
            //console.log(baliseA);     // Validation qu'on obtient bien l'élément voulu. (Voir console navigateur)
            let idZombie = baliseA.attr("id");   // Obtenir l'id en utilisant attr sur l'élément <a> cliqué
